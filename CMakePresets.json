{
  "version": 4,
  "configurePresets": [
    {
      "name": "windows-clang-cl",
      "displayName": "Windows Ninja + ClangCL",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_win",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT": "$env{SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT}",
        "SINDRE_BUILD_TESTS": "ON",
        "SINDRE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT": "$env{SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT}",
        "SINDRE_BUILD_TESTS": "ON",
        "SINDRE_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "linux-clang-core",
      "displayName": "Linux Clang core (without large optional SDKs)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_linux/core",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT": "$env{SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT}",
        "SINDRE_BUILD_TESTS": "ON",
        "SINDRE_BUILD_EXAMPLES": "ON",
        "SINDRE_WITH_AI": "OFF",
        "SINDRE_WITH_GUI": "OFF",
        "SINDRE_WITH_UTILS_2D": "OFF",
        "SINDRE_WITH_UTILS_3D": "OFF",
        "SINDRE_WITH_UTILS_PY": "OFF"
      }
    },
    {
      "name": "windows-clang-cl-core-noexc",
      "displayName": "Windows ClangCL General + Math no-exception core",
      "inherits": "windows-clang-cl",
      "binaryDir": "${sourceDir}/build_win/noexc-core",
      "cacheVariables": {
        "SINDRE_BUILD_TESTS": "ON",
        "SINDRE_BUILD_EXAMPLES": "OFF",
        "SINDRE_NO_EXCEPTIONS": "ON",
        "SINDRE_WITH_AI": "OFF",
        "SINDRE_WITH_GUI": "OFF",
        "SINDRE_WITH_UTILS_2D": "OFF",
        "SINDRE_WITH_UTILS_3D": "OFF",
        "SINDRE_WITH_UTILS_PY": "OFF",
        "SINDRE_MATH_BLAS_BACKEND": "EIGEN"
      }
    },
    {
      "name": "ai-trt-full",
      "displayName": "AI TensorRT Full builder",
      "inherits": "windows-clang-cl",
      "binaryDir": "${sourceDir}/build_win/ai-trt-full",
      "cacheVariables": {
        "SINDRE_BUILD_TESTS": "OFF",
        "SINDRE_BUILD_EXAMPLES": "ON",
        "SINDRE_WITH_AI": "ON",
        "SINDRE_WITH_GUI": "OFF",
        "SINDRE_WITH_UTILS_2D": "OFF",
        "SINDRE_WITH_UTILS_3D": "OFF",
        "SINDRE_WITH_UTILS_PY": "OFF",
        "SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT": "$env{SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT}",
        "SINDRE_AI_ONNXRUNTIME": "OFF",
        "SINDRE_AI_TRT": "ON",
        "SINDRE_AI_TRT_RUNTIME": "FULL",
        "SINDRE_TENSORRT_ROOT": "$env{SINDRE_TENSORRT_ROOT}",
        "CUDAToolkit_ROOT": "$env{CUDAToolkit_ROOT}"
      }
    },
    {
      "name": "ai-trt-dispatch",
      "displayName": "AI TensorRT Dispatch runtime",
      "inherits": "windows-clang-cl",
      "binaryDir": "${sourceDir}/build_win/ai-trt-dispatch",
      "cacheVariables": {
        "SINDRE_BUILD_TESTS": "OFF",
        "SINDRE_BUILD_EXAMPLES": "ON",
        "SINDRE_WITH_AI": "ON",
        "SINDRE_WITH_GUI": "OFF",
        "SINDRE_WITH_UTILS_2D": "OFF",
        "SINDRE_WITH_UTILS_3D": "OFF",
        "SINDRE_WITH_UTILS_PY": "OFF",
        "SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT": "$env{SINDRE_THIRD_GENERAL_PACKAGE_CACHE_ROOT}",
        "SINDRE_AI_ONNXRUNTIME": "OFF",
        "SINDRE_AI_TRT": "ON",
        "SINDRE_AI_TRT_RUNTIME": "DISPATCH",
        "SINDRE_TENSORRT_ROOT": "$env{SINDRE_TENSORRT_ROOT}",
        "CUDAToolkit_ROOT": "$env{CUDAToolkit_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-cl",
      "configurePreset": "windows-clang-cl"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "linux-clang-core",
      "configurePreset": "linux-clang-core"
    },
    {
      "name": "windows-clang-cl-core-noexc",
      "configurePreset": "windows-clang-cl-core-noexc"
    },
    {
      "name": "ai-trt-full",
      "configurePreset": "ai-trt-full"
    },
    {
      "name": "ai-trt-dispatch",
      "configurePreset": "ai-trt-dispatch"
    }
  ],
  "testPresets": [
    {
      "name": "windows-clang-cl",
      "configurePreset": "windows-clang-cl",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-clang-core",
      "configurePreset": "linux-clang-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-cl-core-noexc",
      "configurePreset": "windows-clang-cl-core-noexc",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
