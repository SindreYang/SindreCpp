@PACKAGE_INIT@

# Nested find_dependency() calls may change PACKAGE_PREFIX_DIR. Preserve the
# sindrecpp installation prefix before resolving any external package.
set(_sindre_package_prefix_dir "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@SINDRE_WITH_EIGEN@)
    if(@SINDRE_EIGEN_BUNDLED@)
        if(NOT TARGET Eigen3::Eigen)
            add_library(Eigen3::Eigen INTERFACE IMPORTED)
            set_target_properties(Eigen3::Eigen PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${_sindre_package_prefix_dir}/include/eigen3")
        endif()
    else()
        find_dependency(Eigen3 3.4.1 CONFIG)
    endif()
endif()
if(@SINDRE_EIGEN_BLAS_ENABLED@)
    set(BLA_VENDOR "@SINDRE_EIGEN_BLAS_BACKEND@")
    if(BLA_VENDOR STREQUAL "OPENBLAS")
        find_dependency(OpenBLAS CONFIG)
        if(DEFINED OpenBLAS_INCLUDE_DIRS AND NOT DEFINED BLAS_LIBRARIES)
            get_filename_component(_sindre_openblas_root
                "${OpenBLAS_INCLUDE_DIRS}" DIRECTORY)
            if(EXISTS "${_sindre_openblas_root}/lib/@SINDRE_THIRD_GENERAL_OPENBLAS_IMPORT_LIBRARY@")
                set(BLAS_LIBRARIES
                    "${_sindre_openblas_root}/lib/@SINDRE_THIRD_GENERAL_OPENBLAS_IMPORT_LIBRARY@"
                    CACHE STRING "OpenBLAS import library" FORCE)
            endif()
        endif()
    endif()
    find_dependency(BLAS)
endif()
if(@SINDRE_WITH_LOG@ AND NOT @SINDRE_SPDLOG_BUNDLED@)
    find_dependency(spdlog CONFIG)
endif()
if(@SINDRE_WITH_HTTP@)
    if(NOT @SINDRE_HTTPLIB_BUNDLED@)
        find_dependency(httplib CONFIG)
    endif()
    if(@SINDRE_HTTP_OPENSSL@)
        find_dependency(OpenSSL CONFIG)
    endif()
endif()
if(@SINDRE_WITH_CRYPTO@ AND NOT @SINDRE_HTTP_OPENSSL@)
    find_dependency(OpenSSL CONFIG)
endif()
if(@SINDRE_WITH_JSON@)
    if(NOT @SINDRE_SIMDJSON_BUNDLED@)
        find_dependency(simdjson CONFIG)
    endif()
endif()
if(@SINDRE_WITH_CLI@ AND NOT @SINDRE_ARGPARSE_BUNDLED@)
    find_dependency(argparse CONFIG)
endif()
if(@SINDRE_WITH_ZLIB@)
    find_dependency(ZLIB)
endif()
if(@SINDRE_WITH_UTILS_2D@)
    find_dependency(OpenCV @SINDRE_THIRD_UTILS_2D_OPENCV_MIN_VERSION@
        COMPONENTS @SINDRE_THIRD_UTILS_2D_OPENCV_COMPONENTS@)
endif()
if(@SINDRE_WITH_UTILS_3D@)
    find_dependency(VTK @SINDRE_THIRD_UTILS_3D_VTK_MIN_VERSION@
        COMPONENTS @SINDRE_UTILS_3D_VTK_COMPONENTS@)
    if(@SINDRE_UTILS_3D_CGAL@)
        find_dependency(CGAL @SINDRE_THIRD_UTILS_3D_CGAL_MIN_VERSION@ CONFIG)
    endif()
    if(@SINDRE_UTILS_3D_MESHLIB@)
        find_dependency(meshlib CONFIG)
    endif()
    if(@SINDRE_UTILS_3D_OPEN3D@)
        find_dependency(Open3D CONFIG)
    endif()
    if(@SINDRE_UTILS_3D_IGL@ AND @SINDRE_UTILS_3D_IGL_PACKAGE_FOUND@)
        find_dependency(libigl CONFIG)
    endif()
endif()
if(@SINDRE_WITH_UTILS_PY@)
    find_dependency(Python3 3.12 COMPONENTS Interpreter Development.Embed)
    find_dependency(pybind11 CONFIG)
endif()
if(@SINDRE_AI_ONNXRUNTIME@)
    if(@SINDRE_AI_ONNXRUNTIME_BUNDLED@)
        add_library(sindre::ai_onnxruntime_native UNKNOWN IMPORTED)
        set_target_properties(sindre::ai_onnxruntime_native PROPERTIES
            IMPORTED_LOCATION
                "${_sindre_package_prefix_dir}/lib/sindre/onnxruntime/onnxruntime.lib"
            INTERFACE_INCLUDE_DIRECTORIES
                "${_sindre_package_prefix_dir}/include/sindre/third_party/onnxruntime")
    else()
        find_dependency(onnxruntime CONFIG)
        if(TARGET onnxruntime::onnxruntime)
            set(_sindre_onnxruntime_target onnxruntime::onnxruntime)
        elseif(TARGET onnxruntime)
            set(_sindre_onnxruntime_target onnxruntime)
        else()
            message(FATAL_ERROR "sindrecpp AI requires an onnxruntime CMake target")
        endif()
        add_library(sindre::ai_onnxruntime_native INTERFACE IMPORTED)
        set_target_properties(sindre::ai_onnxruntime_native PROPERTIES
            INTERFACE_LINK_LIBRARIES "${_sindre_onnxruntime_target}")
    endif()
endif()
if(@SINDRE_AI_TRT_ENABLED@)
    find_dependency(CUDAToolkit @SINDRE_THIRD_AI_CUDA_MIN_VERSION@)
    add_library(sindre::ai_tensorrt_native INTERFACE IMPORTED)
    if(TARGET TensorRT::nvinfer AND TARGET TensorRT::nvinfer_plugin AND
       TARGET TensorRT::nvonnxparser)
        set_target_properties(sindre::ai_tensorrt_native PROPERTIES
            INTERFACE_LINK_LIBRARIES
                "TensorRT::nvinfer;TensorRT::nvinfer_plugin;TensorRT::nvonnxparser;CUDA::cudart")
    else()
        find_path(_sindre_tensorrt_include NvInfer.h
            HINTS ENV TENSORRT_ROOT ENV SINDRE_TENSORRT_ROOT
            PATH_SUFFIXES include)
        find_library(_sindre_nvinfer nvinfer nvinfer_10
            HINTS ENV TENSORRT_ROOT ENV SINDRE_TENSORRT_ROOT
            PATH_SUFFIXES lib lib64)
        find_library(_sindre_nvinfer_plugin nvinfer_plugin
            HINTS ENV TENSORRT_ROOT ENV SINDRE_TENSORRT_ROOT
            PATH_SUFFIXES lib lib64)
        find_library(_sindre_nvonnxparser nvonnxparser
            HINTS ENV TENSORRT_ROOT ENV SINDRE_TENSORRT_ROOT
            PATH_SUFFIXES lib lib64)
        if(NOT _sindre_tensorrt_include OR NOT _sindre_nvinfer OR
           NOT _sindre_nvinfer_plugin OR NOT _sindre_nvonnxparser)
            message(FATAL_ERROR
                "sindrecpp TensorRT requires TensorRT:: targets or TENSORRT_ROOT")
        endif()
        set_target_properties(sindre::ai_tensorrt_native PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${_sindre_tensorrt_include}"
            INTERFACE_LINK_LIBRARIES
                "${_sindre_nvinfer};${_sindre_nvinfer_plugin};${_sindre_nvonnxparser};CUDA::cudart")
    endif()
endif()
if(@SINDRE_WITH_RE2@)
    find_dependency(re2 CONFIG)
endif()
if(@SINDRE_WITH_CRASHPAD@)
    find_dependency(crashpad CONFIG)
endif()
if(@SINDRE_WITH_GUI@ AND @SINDRE_GUI_GLFW_OPENGL3@)
    find_dependency(glfw3 CONFIG)
    find_dependency(OpenGL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sindrecppTargets.cmake")

if(@SINDRE_WITH_CRASHPAD@ AND TARGET sindre::general_crashpad)
    # The build-time Crashpad target may contain absolute package paths and is
    # intentionally not serialized into the export file. Reattach the target
    # discovered by find_dependency() after the package is loaded.
    if(TARGET crashpad)
        set_property(TARGET sindre::general_crashpad APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES crashpad)
    elseif(TARGET crashpad::crashpad)
        set_property(TARGET sindre::general_crashpad APPEND PROPERTY
            INTERFACE_LINK_LIBRARIES crashpad::crashpad)
    endif()
endif()
