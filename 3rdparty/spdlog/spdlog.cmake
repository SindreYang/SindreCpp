# spdlog 作为 General 的静态日志后端，关闭上游示例和测试，
# 仅保留项目需要的安装头文件和库文件。
include(ExternalProject)

set(SINDRE_THIRD_GENERAL_SPDLOG_VERSION "1.17.0")
set(SINDRE_THIRD_GENERAL_SPDLOG_URL
    "https://github.com/gabime/spdlog/archive/refs/tags/v1.17.0.zip")
set(SINDRE_THIRD_GENERAL_SPDLOG_SHA256
    "b11912a82d149792fef33fabd0503b13d54aeac25c1464755461d4108ea71fc2")

ExternalProject_Add(
    sindre_ext_spdlog
    PREFIX "${SINDRE_THIRD_PARTY_CACHE_DIR}/spdlog"
    URL "${SINDRE_THIRD_GENERAL_SPDLOG_URL}"
    URL_HASH "SHA256=${SINDRE_THIRD_GENERAL_SPDLOG_SHA256}"
    DOWNLOAD_DIR "${SINDRE_THIRD_PARTY_DOWNLOAD_DIR}/spdlog"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    CMAKE_ARGS
        ${SINDRE_EXTERNAL_PROJECT_CMAKE_ARGS}
        -DSPDLOG_BUILD_SHARED=OFF
        -DSPDLOG_BUILD_TESTS=OFF
        -DSPDLOG_BUILD_EXAMPLE=OFF
        -DSPDLOG_INSTALL=ON
        -DCMAKE_INSTALL_LIBDIR=lib
        -DCMAKE_INSTALL_PREFIX=<INSTALL_DIR>
    BUILD_BYPRODUCTS
        <INSTALL_DIR>/lib/${CMAKE_STATIC_LIBRARY_PREFIX}spdlog${CMAKE_STATIC_LIBRARY_SUFFIX})
ExternalProject_Get_Property(sindre_ext_spdlog INSTALL_DIR)
set(SINDRE_THIRD_GENERAL_SPDLOG_INCLUDE_DIR "${INSTALL_DIR}/include")
file(MAKE_DIRECTORY "${SINDRE_THIRD_GENERAL_SPDLOG_INCLUDE_DIR}")
set(SINDRE_THIRD_GENERAL_SPDLOG_LIBRARY
    "${INSTALL_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}spdlog${CMAKE_STATIC_LIBRARY_SUFFIX}")
