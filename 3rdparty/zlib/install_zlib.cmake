if(NOT DEFINED ZLIB_SOURCE_DIR OR NOT DEFINED ZLIB_BINARY_DIR OR
   NOT DEFINED ZLIB_INSTALL_DIR OR NOT DEFINED ZLIB_LIBRARY_NAME)
    message(FATAL_ERROR "zlib install helper received incomplete paths")
endif()

file(MAKE_DIRECTORY "${ZLIB_INSTALL_DIR}/include" "${ZLIB_INSTALL_DIR}/lib")
file(COPY "${ZLIB_SOURCE_DIR}/zlib.h" DESTINATION "${ZLIB_INSTALL_DIR}/include")
file(COPY "${ZLIB_BINARY_DIR}/zconf.h" DESTINATION "${ZLIB_INSTALL_DIR}/include")
file(COPY "${ZLIB_BINARY_DIR}/${ZLIB_LIBRARY_NAME}" DESTINATION "${ZLIB_INSTALL_DIR}/lib")
