# RE2 是小型库，不能从 General 的 vcpkg profile 取得。固定源码包、
# SHA-256 和静态构建结果，并只向 General 暴露项目自己的导入 target。
include(ExternalProject)

set(SINDRE_THIRD_GENERAL_RE2_VERSION "2024-04-01")
set(SINDRE_THIRD_GENERAL_RE2_URL
    "https://github.com/google/re2/archive/refs/tags/2024-04-01.zip")
set(SINDRE_THIRD_GENERAL_RE2_SHA256
    "3DBED752E5C699508B0F88D700A47AD7072CD42CB2D504369F8E3EE01F32A09D")

ExternalProject_Add(
    sindre_ext_re2
    PREFIX "${SINDRE_THIRD_PARTY_BUILD_CACHE_DIR}/re2"
    URL "${SINDRE_THIRD_GENERAL_RE2_URL}"
    URL_HASH "SHA256=${SINDRE_THIRD_GENERAL_RE2_SHA256}"
    DOWNLOAD_DIR "${SINDRE_THIRD_PARTY_DOWNLOAD_DIR}/re2"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    CMAKE_ARGS
        ${SINDRE_EXTERNAL_PROJECT_CMAKE_ARGS}
        -DBUILD_SHARED_LIBS=OFF
        -DRE2_BUILD_TESTING=OFF
        -DRE2_USE_ICU=OFF
        -DRE2_BUILD_FRAMEWORK=OFF
        -DCMAKE_PREFIX_PATH=${SINDRE_THIRD_GENERAL_ABSEIL_INSTALL_DIR}
        -DCMAKE_INSTALL_LIBDIR=lib
        -DCMAKE_INSTALL_PREFIX=<INSTALL_DIR>
    BUILD_BYPRODUCTS
        <INSTALL_DIR>/lib/${CMAKE_STATIC_LIBRARY_PREFIX}re2${CMAKE_STATIC_LIBRARY_SUFFIX})
ExternalProject_Get_Property(sindre_ext_re2 INSTALL_DIR)
add_dependencies(sindre_ext_re2 sindre_ext_abseil)
set(SINDRE_THIRD_GENERAL_RE2_INSTALL_DIR "${INSTALL_DIR}")
set(SINDRE_THIRD_GENERAL_RE2_INCLUDE_DIR "${INSTALL_DIR}/include")
set(SINDRE_THIRD_GENERAL_RE2_LIBRARY
    "${INSTALL_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}re2${CMAKE_STATIC_LIBRARY_SUFFIX}")
file(MAKE_DIRECTORY "${SINDRE_THIRD_GENERAL_RE2_INCLUDE_DIR}")
