# simdjson 作为 General 的静态 JSON 后端，固定下载校验、关闭上游测试，
# 并通过安装前缀生成供项目使用的 include/lib 路径。
include(ExternalProject)

set(SINDRE_THIRD_GENERAL_SIMDJSON_VERSION "4.6.11")
set(SINDRE_THIRD_GENERAL_SIMDJSON_URL
    "https://github.com/simdjson/simdjson/archive/refs/tags/v4.6.11.zip")
set(SINDRE_THIRD_GENERAL_SIMDJSON_SHA256
    "5a3bc470d53b0324dfcbef952fdbd004655d7a4f7a6558fb94122cb9f233f2d0")

ExternalProject_Add(
    sindre_ext_simdjson
    PREFIX "${SINDRE_THIRD_PARTY_BUILD_CACHE_DIR}/simdjson"
    URL "${SINDRE_THIRD_GENERAL_SIMDJSON_URL}"
    URL_HASH "SHA256=${SINDRE_THIRD_GENERAL_SIMDJSON_SHA256}"
    DOWNLOAD_DIR "${SINDRE_THIRD_PARTY_DOWNLOAD_DIR}/simdjson"
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    CMAKE_ARGS
        ${SINDRE_EXTERNAL_PROJECT_CMAKE_ARGS}
        -DSIMDJSON_DEVELOPER_MODE=OFF
        -DSIMDJSON_BUILD_STATIC=ON
        -DSIMDJSON_BUILD_SHARED=OFF
        -DSIMDJSON_BUILD_TESTS=OFF
        -DSIMDJSON_BUILD_BENCHMARKS=OFF
        -DSIMDJSON_INSTALL=ON
        -DCMAKE_INSTALL_LIBDIR=lib
        -DCMAKE_INSTALL_PREFIX=<INSTALL_DIR>
    BUILD_BYPRODUCTS
        <INSTALL_DIR>/lib/${CMAKE_STATIC_LIBRARY_PREFIX}simdjson${CMAKE_STATIC_LIBRARY_SUFFIX})
ExternalProject_Get_Property(sindre_ext_simdjson INSTALL_DIR)
set(SINDRE_THIRD_GENERAL_SIMDJSON_INCLUDE_DIR "${INSTALL_DIR}/include")
file(MAKE_DIRECTORY "${SINDRE_THIRD_GENERAL_SIMDJSON_INCLUDE_DIR}")
set(SINDRE_THIRD_GENERAL_SIMDJSON_LIBRARY
    "${INSTALL_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}simdjson${CMAKE_STATIC_LIBRARY_SUFFIX}")
